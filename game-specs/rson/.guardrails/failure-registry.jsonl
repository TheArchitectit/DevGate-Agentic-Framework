{"failure_id":"FAIL-RSON-004","timestamp":"2026-08-07T21:50:00Z","category":"logic","severity":"medium","error_message":"show_interstitial returns false silently — ad display function fails without logging or fallback, making monetization debugging impossible","root_cause":"show_interstitial() has a bare 'return false' without push_warning, push_error, or any diagnostic logging on all early-exit paths","affected_files":["ad_manager.gd"],"fix_commit":"pending","regression_pattern":"func\\s+show_interstitial.*\\n.*return\\s+false\\s*$","prevention_rule":"PREVENT-RSON-003: All ad/IAP functions must log warnings on failure paths before returning false/null","status":"active","updated_at":"2026-08-07T21:50:00Z"}
{"failure_id":"FAIL-RSON-005","timestamp":"2026-08-07T21:50:00Z","category":"stub","severity":"high","error_message":"Remove Ads IAP completely stubbed — the IAP node is never added to the scene tree, so the purchase flow cannot execute","root_cause":"Remove Ads IAP handler instantiated with .new() but never add_child()ed to scene tree; purchase callbacks reference unconnected signals","affected_files":["iap_manager.gd","ad_manager.gd"],"fix_commit":"pending","regression_pattern":"\\.new\\(\\)(?!.*add_child)|iap.*\\.new\\(\\).*\\n(?!.*add_child)","prevention_rule":"PREVENT-RSON-004: IAP nodes must be added to scene tree in _ready() and verified via is_inside_tree() check","status":"active","updated_at":"2026-08-07T21:50:00Z"}
