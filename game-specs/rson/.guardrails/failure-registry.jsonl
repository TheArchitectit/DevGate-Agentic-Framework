{"failure_id":"FAIL-RSON-008","timestamp":"2026-08-07T21:50:00Z","category":"performance","severity":"medium","error_message":"PointLight2D and SceneTreeTimer allocated per shot — each projectile creates a new light node and timer, causing GC pressure and visual flicker","root_cause":"Projectile spawn code instantiates PointLight2D via .new() and creates SceneTreeTimer via get_tree().create_timer() on every shot without pooling","affected_files":["projectile.gd","weapon.gd"],"fix_commit":"pending","regression_pattern":"PointLight2D\\.new\\(\\).*_ready|create_timer.*projectile|PointLight2D.*new\\(\\).*shoot","prevention_rule":"PREVENT-RSON-007: Never allocate nodes or timers per-shot; use object pooling for projectiles and reuse PointLight2D instances","status":"active","updated_at":"2026-08-07T21:50:00Z"}
